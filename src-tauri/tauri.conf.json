{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fastDev",
  "version": "0.1.0",
  "identifier": "dev.fastdev.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "fastDev",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 24 },
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Versioned library of project skeletons",
    "copyright": "fastDev",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/fastdev-mcp"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
